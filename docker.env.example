# 复制为 .env（供 docker compose 读取）后填入真实值；.env 已被 .gitignore 忽略，勿提交。
# 生产环境建议用长随机串：openssl rand -hex 32

# 后端密钥
JWT_SECRET=change-me-openssl-rand-hex-32
TEACHER_PASSWORD=teacher123
ADMIN_PASSWORD=admin123
STUDENT_DEFAULT_PASSWORD=123456

# 前端同源地址（构建期烘焙；改端口/域名需重新 docker compose build）
VITE_API_BASE_URL=http://localhost:8080

# 宿主机端口（前端）
WEB_PORT=8080
